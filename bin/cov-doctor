#!/bin/zsh
set -u

failed=0

check_executable() {
  local label=$1
  local executable=$2
  if [[ -x "$executable" ]]; then
    print "PASS  $label: $executable"
  else
    print "FAIL  $label: $executable"
    failed=1
  fi
}

SCRIPT_DIR="${0:A:h}"
REPO_DIR="${SCRIPT_DIR:h}"

check_executable "COVIT" "${HOME}/.local/bin/covit"
check_executable "Python 3.12" "/opt/homebrew/opt/python@3.12/libexec/bin/python3"
check_executable "macOS open" "/usr/bin/open"
check_executable "AppleScript" "/usr/bin/osascript"
check_executable "Ghostty" "/Applications/Ghostty.app/Contents/MacOS/ghostty"

if /opt/homebrew/opt/python@3.12/libexec/bin/python3 -c 'import mutagen' 2>/dev/null; then
  print "PASS  Python module: mutagen"
else
  print "FAIL  Python module: mutagen"
  failed=1
fi

for command_name in cov-open cov-open-embed cov-embed cov-finder cov-choose cov-swinsian cov-clipboard cov-context cov-tui cov-search cov-ghostty cov-log; do
  command_path="${REPO_DIR}/bin/$command_name"
  check_executable "$command_name" "$command_path"
done

log_path="${HOME}/Library/Logs/cov-toolkit.log"
print "INFO  Log: $log_path"

if (( failed )); then
  print
  print "COV toolkit has missing requirements."
  exit 1
fi

if /opt/homebrew/opt/python@3.12/libexec/bin/python3 -c 'import textual' 2>/dev/null; then
  print "PASS  Python module: textual"
else
  print "FAIL  Python module: textual"
  failed=1
fi

print
print "COV toolkit is ready."
